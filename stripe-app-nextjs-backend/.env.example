# ============================================================================
#  Environment variables
#
#  `npm run setup` fills in everything below that it can: it asks for your
#  Supabase connection, generates every random secret and reads your Stripe
#  test key from `stripe login`. It writes to .env.local and only ever adds
#  missing values. Prefer doing it by hand? Copy this file to .env.local.
#
#  .env (if present) is written by `stripe projects env --pull` — the Vercel
#  credentials, and the Supabase credentials if you chose to provision
#  Supabase through Stripe Projects. Don't edit it; the CLI owns it.
#  .env.local wins over .env.
# ============================================================================

# ----------------------------------------------------------------------------
#  Database (Supabase Postgres) — your own project
# ----------------------------------------------------------------------------
# Better Auth connects here directly; `npm run db:setup` applies setup.sql
# over this connection. Copy the *Session pooler* connection string from
# your Supabase project (Connect button in the dashboard toolbar).
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional — install the tables into a dedicated Postgres schema instead of
# `public`. Lets you reuse a Supabase project you already have without using
# up one of the free tier's project slots. `npm run db:setup` creates the
# schema, installs the tables there and grants the API roles access; you
# must then add the schema to "Exposed schemas" in the Supabase dashboard
# (Settings → API) so supabase-js can query it. Use the *Session pooler*
# connection string with this option. Leave unset for public.
# SEE ALSO: https://supabase.com/docs/guides/api/using-custom-schemas
# SUPABASE_SCHEMA=stripe_app

# Dashboard → Project Settings → API Keys. The backend's data access goes
# through supabase-js with the secret / service_role key, which bypasses Row
# Level Security — keep it server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Not used by the current backend code (it never queries as anon), but
# standard to have around if you add browser-side Supabase access later.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ----------------------------------------------------------------------------
#  Option: Supabase provisioned by Stripe Projects
#  (`stripe projects add supabase/project` — creates a brand-new project; it
#  can't reuse an existing one or use a dedicated schema)
#  These are written to .env; src/lib/env.ts maps them onto the names above,
#  so leave the block above alone when you go this route.
# ----------------------------------------------------------------------------
# SUPABASE_PROJECT_URL=https://xxxx.supabase.co     → NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...       → NEXT_PUBLIC_SUPABASE_ANON_KEY
# SUPABASE_SECRET_KEY=sb_secret_...                 → SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_POOLER_URL=postgresql://...pooler.supabase.com:5432/postgres  → DATABASE_URL
# SUPABASE_DB_URL=postgresql://...                  (direct; IPv6-only, fallback)
# SUPABASE_PROJECT_REF=xxxx
# SUPABASE_DB_PASS=...
#
# If the provider doesn't include a secret key, copy it from the Supabase
# dashboard (`stripe projects open supabase` → Project Settings → API Keys)
# and store it as a project variable so every teammate gets it:
#   stripe projects variables set supabase-secret-key --env-key SUPABASE_SECRET_KEY

# ----------------------------------------------------------------------------
#  Vercel — written to .env by `stripe projects add vercel/project`.
#  Read only by `npm run deploy` (scripts/deploy-vercel.mjs), never at runtime.
# ----------------------------------------------------------------------------
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_URL=

# ----------------------------------------------------------------------------
#  Better Auth (session auth for browser traffic)
#  `npm run setup` generates the secret; `npm run deploy` rewrites the URL
#  to the Vercel production URL. The browser-side client needs no URL: it
#  calls /api/auth on the page's own origin.
# ----------------------------------------------------------------------------
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=https://localhost:3006

# ----------------------------------------------------------------------------
#  Stripe API keys & webhook secrets (see src/lib/stripe.ts for the full
#  mental model: 2 accounts x 3 environments)
# ----------------------------------------------------------------------------
# Required — the account your Stripe App lives in. `npm run setup` fills in
# the test key from your `stripe login` session:
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_SECRET_KEY_LIVE=sk_live_...
STRIPE_SECRET_KEY_MANAGED_SANDBOX=sk_test_...

# The app webhook, /api/webhooks/app (src/pages/api/webhooks/app.ts): events
# from the accounts your app is installed in. One signing secret per endpoint
# you register — README.md lists them. Locally, one command
# prints the whsec_ for the test one:
#   stripe listen --forward-connect-to "https://localhost:3006/api/webhooks/app?mode=test&type=connected" --forward-to "https://localhost:3006/api/webhooks/billing?mode=test" --skip-verify
STRIPE_WEBHOOK_SECRET_TEST_CONNECTED=whsec_...
STRIPE_WEBHOOK_SECRET_LIVE_CONNECTED=whsec_...
STRIPE_WEBHOOK_SECRET_MANAGED_SANDBOX_CONNECTED=whsec_...

# Optional — events in your OWN account (/api/webhooks/app?…&type=account):
# STRIPE_WEBHOOK_SECRET_LIVE_ACCOUNT=whsec_...
# STRIPE_WEBHOOK_SECRET_TEST_ACCOUNT=whsec_...
# Those events carry no account id; this is the acct_… they are about.
# STRIPE_APP_ACCOUNT_ID=acct_...

# Optional — separate billing account (falls back to the app account). The
# webhook secrets are for /api/webhooks/billing (src/pages/api/webhooks/billing.ts):
# STRIPE_BILLING_SECRET_KEY_LIVE=sk_live_...
# STRIPE_BILLING_SECRET_KEY_TEST=sk_test_...
# STRIPE_BILLING_WEBHOOK_SECRET_LIVE=whsec_...
# STRIPE_BILLING_WEBHOOK_SECRET_TEST=whsec_...

# ----------------------------------------------------------------------------
#  Paywall & billing (src/lib/paywall.ts, src/lib/billing.ts)
#  All optional — the defaults give a 90-day, 100-note trial in live mode
#  and no paywall in test mode.
# ----------------------------------------------------------------------------
# How long a free trial lasts once someone in the Stripe account starts it,
# in days. 0 switches the time limit off.
# TRIAL_DAYS_LIMIT=90
# How many notes a free trial includes (creating a note is the paid feature),
# shared by everyone in the Stripe account. 0 switches the cap off.
# TRIAL_COUNT_LIMIT=100
# Test mode is never paywalled. Set this to true to rehearse the paywall
# locally in test mode (it then checks test-mode subscriptions). Leave unset
# in production.
# PAYWALL_ENFORCE_IN_TEST_MODE=true
# Which mode the website's /billing page sells in: test (default; Stripe
# test cards, no money moves) or live. Set to live in production.
# BILLING_ENVIRONMENT=test

# ============================================================================
#  Proxy authentication (src/proxy.ts + src/lib/proxy-auth.ts)
#  One variable per auth flavor. `npm run setup` generates the random ones.
# ============================================================================

# --- Stripe App signature auth ---------------------------------------------
# The "Signing secret" from your app's settings page in the Stripe
# Developers Dashboard (https://dashboard.stripe.com/apps → your app).
# Verifies the `stripe-signature` header sent by fetchStripeSignature()
# in the UI extension.
#
# NOTE: this secret only exists AFTER you run `stripe apps upload` once —
# locally previewed apps don't have one. Uploading is NOT publishing: the
# app stays private to your Stripe account until you separately submit it
# for review and build a Marketplace listing, so upload freely.
STRIPE_APP_SIGNING_SECRET=absec_...

# --- Bearer token auth -------------------------------------------------------
# Comma-separated list of accepted keys for `Authorization: Bearer <key>`.
BEARER_TOKEN_KEYS=key-one,key-two

# Accepted anywhere a bearer key is. When set on Vercel, Vercel Cron sends it
# as `Authorization: Bearer <CRON_SECRET>`. https://vercel.com/docs/cron-jobs
CRON_SECRET=your-cron-secret

# --- Local dev API key -------------------------------------------------------
# Accepted as a bearer token ONLY when NODE_ENV=development (i.e. `next dev`).
# Lets you curl authenticated routes locally without a session or real key.
DEV_API_KEY=local-dev-only-key

# --- User API keys (future work) --------------------------------------------
# Per-user keys will be stored (hashed) in the database and checked in
# verifyApiKey() in src/lib/proxy-auth.ts. No env var needed yet.

# ----------------------------------------------------------------------------
#  Email (Postmark) — optional. src/lib/email.ts; used by sendResetPassword
#  in src/lib/auth.ts, by the welcome / goodbye emails the app webhook sends
#  on install / uninstall, and by the "a task was assigned to you" email
#  (src/lib/email-templates.ts). Without both values the password reset link
#  and the assignment email are printed to the backend terminal instead of
#  emailed (under `next dev`), and the install emails are skipped.
# ----------------------------------------------------------------------------
# Postmark → your server → API Tokens.
# POSTMARK_SERVER_API_TOKEN=
# Must be a sender signature or domain verified in Postmark.
# POSTMARK_FROM_EMAIL=you@yourdomain.com
# Optional — defaults to Postmark's transactional stream, "outbound".
# POSTMARK_MESSAGE_STREAM=outbound
